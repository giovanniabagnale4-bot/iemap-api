from math import pi
import numpy as np
import matplotlib.pyplot as plt
from tqdm import tqdm  # Importing tqdm for the progress bar
import scipy.constants as const
from prettytable import PrettyTable

# Lattice constant of Silicon (in m)
a = 5.65e-10  

# Offset from the central node in the Bravais lattice (in units of a)
tau = (0.010) * np.ones((3,))  # Array of length 3 representing the offset

# Base vectors of the reciprocal lattice (in units of 2 * np.pi / a)
basis = np.array([
    [1, -1, 1],
    [1, 1, -1],
    [-1, 1, 1]])

# Conversion factors
J_to_eV = 6.2415e18
Ry_to_eV = 13.6057039763


def V_ps(G): # shape factor
    G_dot = np.dot(G, G)
    if np.isclose(G_dot, 3, atol=1e-5):
        return 0.000643 * Ry_to_eV
    elif np.isclose(G_dot, 8, atol=1e-5):
        return 0.0240028 * Ry_to_eV
    elif np.isclose(G_dot, 11, atol=1e-5):
        return  -0.1192 * Ry_to_eV
    else:
        return 0


def V_ps_TOT(G):
    S = np.cos(2 * np.pi * np.dot(G, tau))  # Structure factor
    V = V_ps(G) * S  
    return V


def T(G, k):
    T_const = const.hbar**2 / (2 * const.m_e)  
    T = T_const * (np.linalg.norm(k + G) * (2 * np.pi / a))**2 * J_to_eV  
    return T


def index_generator(m, states):
    n = (states ** 3) // 2
    s = m + n
    floor = states // 2
    h = s // states ** 2 - floor
    k = s % states ** 2 // states - floor
    l = s % states - floor
    return np.array([h, k, l])


def vector_matrix(states, basis):
    n = states ** 3
    G_matrix = np.array([np.dot(index_generator(i - n // 2, states), basis) for i in range(n)])
    return G_matrix


def H_fill(G_matrix, k):
    l = len(G_matrix)
    H = np.zeros((l, l))
    for i in range(l):
        H[i, i] = T(G_matrix[i], k)
        for j in range(i + 1, l):
            H[i, j] = V_ps_TOT(G_matrix[j] - G_matrix[i])
            H[j, i] = H[i, j]  
    return H


if __name__ == "__main__":

    L = np.array([1, 1 , 1 ])
    Gamma = np.array([0, 0, 0])
    X = np.array([1, 0, 0])
    U = np.array([1, 1 , 1])
    K = np.array([3 / 4, 3 / 4, 0])

    k_path = np.concatenate([
        np.linspace(L, Gamma, 100, endpoint=False),
        np.linspace(Gamma, X, 116, endpoint=False),
        np.linspace(X, U, 41, endpoint=False),
        np.linspace(K, Gamma, 123)
    ])

    G = vector_matrix(7, basis)

    E = []
    for k in tqdm(k_path, desc="Calculating energy eigenvalues"):
        e = np.linalg.eigvalsh(H_fill(G, k))
        E.append(e)
        
    E = np.array(E)

    if E.shape[1] > 3:  
        E_F = np.max(E[:, 3])
    else:
        E_F = np.max(E)
    E -= E_F

    

    plt.figure(figsize=(10, 6))
    for i, band in enumerate(E.T[:8]):
        plt.plot(np.linspace(0, 1, len(k_path)), band, label=f"Band {i + 1}")

    high_symmetry_points = [0, 100, 216, 257, 380]
    labels = ["L", "Γ", "X", "U, K", "Γ"]
    for point in high_symmetry_points:
        plt.axvline(x=point / len(k_path), color="k", linestyle="--")
    plt.xticks([point / len(k_path) for point in high_symmetry_points], labels)

    plt.xlabel("k - path")
    plt.ylabel("Energy (eV)")
    plt.title("Band Structure of Silicon")
    plt.legend()
    current_ylim = plt.ylim()  # Ottieni l'intervallo corrente dell'asse y
plt.yticks(np.arange(int(current_ylim[0]), int(current_ylim[1]) + 1, 1))  # Imposta i tick con step di 1
plt.grid(True)

plt.savefig("BandStructure.png")
plt.show()

# Creazione della tabella
table = PrettyTable()

# Aggiunta delle righe
for row in E:
    table.add_row(row)

# Stampa della tabella
print(table)
